rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── VÉHICULES ────────────────────────────────────────────────────
    match /vehicules/{vehiculeId} {
      allow read: if true; // visible par tous
      allow create: if request.auth != null
        && request.resource.data.proprietaireId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.proprietaireId == request.auth.uid;
    }

    // ── LOGEMENTS ────────────────────────────────────────────────────
    match /logements/{logementId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.proprietaireId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.proprietaireId == request.auth.uid;
    }

    // ── RÉSERVATIONS ─────────────────────────────────────────────────
    match /reservations/{reservationId} {
      allow read: if request.auth != null
        && (resource.data.loueurId == request.auth.uid
         || resource.data.proprietaireId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.loueurId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.proprietaireId == request.auth.uid;
      allow delete: if false;
    }

    // ── CONVERSATIONS ────────────────────────────────────────────────
    match /conversations/{convId} {
      allow read, write: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      match /messages/{msgId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      }
    }

    // ── AVIS ────────────────────────────────────────────────────────
    match /avis/{avisId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.auteurId == request.auth.uid;
      allow update, delete: if false;
    }

    // Tout le reste : refusé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
