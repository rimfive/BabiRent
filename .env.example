# ══════════════════════════════════════════════════════════════════════
# BABI RENT — Variables d'environnement
# Copie ce fichier en ".env" et remplis avec tes vraies clés Firebase
# ⚠️  Ne JAMAIS committer le fichier .env sur GitHub !
# ══════════════════════════════════════════════════════════════════════

# ── FIREBASE ──────────────────────────────────────────────────────────
# console.firebase.google.com → ton projet → Paramètres → Config web
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...ta_vraie_cle
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=babirent-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=babirent-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=babirent-app.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ── GOOGLE MAPS (optionnel pour la carte) ─────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials
EXPO_PUBLIC_GOOGLE_MAPS_KEY=AIzaSy...ta_cle_maps

# ── CLOUDINARY (upload photos) ─────────────────────────────────────────
# cloudinary.com → Dashboard
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=ton_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=babirent_unsigned

# ── CINETPAY (paiement — côté serveur Firebase Functions UNIQUEMENT) ──
# ⚠️  Ces clés NE doivent PAS avoir le préfixe EXPO_PUBLIC_
# Elles sont utilisées uniquement dans Firebase Cloud Functions
CINETPAY_API_KEY=ta_cle_cinetpay
CINETPAY_SITE_ID=ton_site_id
